---
import "../copyToClipboard.css";
import Layout from "./Layout.astro";
import PageLayout from "./PageLayout.astro";
import Navbar from "../components/Navbar.astro";
import Card from "../components/Card.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    image: string;
    slug: string;
    pubDate: Date;
  };
}

const { frontmatter } = Astro.props;
const dateObj = new Date(frontmatter.pubDate);
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <Navbar nav_suffix={`/ blog / ${frontmatter.slug}`} />
  <PageLayout>
    <div class="py-4">
      <Card
        title={frontmatter.title}
        id={frontmatter.slug}
        description={frontmatter.description}
        image={frontmatter.image}
        pubDate={dateObj}
      />
      <div class="reading-content mt-8">
        <slot />
      </div>
    </div>
  </PageLayout>
</Layout>

<script>
  document.querySelectorAll<HTMLPreElement>(".reading-content pre").forEach((pre) => {
    const code = pre.querySelector("code");
    if (!code) return;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "copyToClipboard";
    button.setAttribute("aria-label", "Copy code to clipboard");
    button.innerHTML = '<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4V2H17V4H20.0066C20.5552 4 21 4.44495 21 4.9934V21.0066C21 21.5552 20.5551 22 20.0066 22H3.9934C3.44476 22 3 21.5551 3 20.9934V4.9934C3 4.44476 3.44495 4 3.9934 4H7ZM7 6H5V20H19V6H17V8H7V6ZM9 4V6H15V4H9Z"></path></svg>';
    const label = document.createElement("span");
    label.textContent = "Copy";
    label.setAttribute("aria-live", "polite");
    button.appendChild(label);
    let resetLabel: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      clearTimeout(resetLabel);
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        label.textContent = "Copied";
      } catch {
        label.textContent = "Copy failed";
      }
      resetLabel = setTimeout(() => { label.textContent = "Copy"; }, 2000);
    });
    pre.appendChild(button);
  });
</script>
