---
import { getCollection } from "astro:content";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import PageLayout from "../layouts/PageLayout.astro";

const blogs = await getCollection("blog");
blogs.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

console.log("posts", blogs);
---

<Layout>
  <Navbar nav_suffix="/ blogs" />

  <PageLayout>
    <h1 class="text-xl tracking-wide my-2 sm:text-md sm:my-3">
      I just want a digital place to share my experience on internet and i think
      blogs are my favorite way of doing that.
    </h1>

    <!-- <br> -->
    <hr class="opacity-20 my-5">
    <div class="flex flex-col gap-2 flex-1">
      {
        blogs.map((blog) => (
          <Card
            title={blog.data.title}
            id={blog.id}
            description={blog.data.description}
            image={blog.data.image}
            pubDate={blog.data.pubDate}
          />
        ))
      }
    </div>
  </PageLayout>
</Layout>
