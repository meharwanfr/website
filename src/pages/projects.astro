---
import Card from "../components/Card.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { projects } from "../data/projects";
---

<Layout>
  <Navbar nav_suffix="/ projects" />
  <PageLayout>
    <h1 class="text-3xl font-semibold mt-4 mb-2">projects</h1>
    <p class="text-lg mb-5">
      things i've built, from little terminal tools to games and web apps.
      more on <a class="underline underline-offset-4" href="https://github.com/meharwanfr?tab=repositories" target="_blank" rel="noopener noreferrer">my github</a>.
    </p>
    <div class="flex flex-col gap-y-3">
      {projects.map((project) => (
        <Card
          title={project.title}
          link={project.link}
          description={project.desc}
          image={project.image}
          year={project.year}
          stack={project.stack}
        />
      ))}
    </div>
  </PageLayout>
</Layout>
