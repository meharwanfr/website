---
import GalleryCard from "../components/GalleryCard.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import PageLayout from "../layouts/PageLayout.astro";

const fotus = [
  { image_url: "/src/assets/gallery/avif/dragon_jp.avif", location: "JP Dragon" },
  { image_url: "/src/assets/gallery/avif/familyMart_night.avif", location: "FamilyMart Night" },
  { image_url: "/src/assets/gallery/avif/japanese gate.avif", location: "Japanese Gate" },
  { image_url: "/src/assets/gallery/avif/Japanese sake barrels.avif", location: "Japanese Sake Barrels" },
  { image_url: "/src/assets/gallery/avif/jp_night_streets.avif", location: "JP Night Streets" },
  { image_url: "/src/assets/gallery/avif/lantern_jp.avif", location: "JP Lantern" },
  { image_url: "/src/assets/gallery/avif/mt_takao.avif", location: "Mt. Takao" },
  { image_url: "/src/assets/gallery/avif/segsy view.avif", location: "Segsy View" },
  { image_url: "/src/assets/gallery/avif/Shibuya roads.avif", location: "Shibuya Roads" },
];

---

<Layout>
  <Navbar nav_suffix="/ gallery" />

  <PageLayout>
    <h2 class="text-sm opacity-70">(pics that i took from my trips, mostly from japan and singapore)</h2>
    <br />

    <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-4">
        {
            fotus.map(fotu => <GalleryCard image_url={fotu.image_url} location={fotu.location}/>)
        }
    </div>
  </PageLayout>
</Layout>
