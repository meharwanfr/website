---
import { getImage } from "astro:assets";

const { title, description, pubDate, image, id, link, year, stack } = Astro.props;
let optimizedImage: { src: string } = { src: "" };

if (image && !image.startsWith("http")) {
  const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/**/*.{jpeg,jpg,png,gif,webp}",
  );

  const imagePath = image.startsWith("/") ? image : `/${image}`;

  if (!images[imagePath]) {
    throw new Error(`"${imagePath}" does not exist in glob pattern.`);
  }
  optimizedImage = await getImage({ src: images[imagePath]() });
} else if (image) {
  optimizedImage.src = image;
}
---

<article
  class="w-full min-w-0 p-3 border border-neutral-300 dark:border-neutral-800 flex flex-col md:flex-row gap-4"
>
  {image && <a
    class="block w-full md:w-36 aspect-video md:aspect-square shrink-0 overflow-hidden bg-neutral-500"
    target={!id ? "_blank" : ""}
    rel={!id ? "noopener noreferrer" : undefined}
    href={!id ? link : `/blog/${id}`}
  >
    <img
      class="w-full h-full object-cover"
      src={optimizedImage.src}
      alt={title}
      loading="lazy"
      decoding="async"
    />
  </a>}

  <div class="w-full flex flex-col justify-between min-w-0">
    <div class="flex flex-col gap-1">
      <h2 class="font-semibold text-lg leading-snug">
        <a
          class="hover:underline text-2xl md:text-xl"
          target={!id ? "_blank" : ""}
          rel={!id ? "noopener noreferrer" : undefined}
          href={!id ? link : `/blog/${id}`}>{title}</a
        >
      </h2>
      <p
        class="text-lg text-secondary leading-relaxed"
      >
        {description}
      </p>
    </div>

    <div class="flex flex-wrap justify-between gap-x-4 gap-y-1 text-sm text-muted mt-3">
      {stack && <p class="font-ibm-mono">{stack}</p>}
      {year ? <p class="ml-auto">{year}</p> : pubDate && <time class="ml-auto" datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString()}</time>}
    </div>
  </div>
</article>
