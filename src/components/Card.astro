---
import { getImage } from "astro:assets";

const { title, description, pubDate, image, id, link } = Astro.props;
let optimizedImage: { src: string } = { src: "" };

if (!image.startsWith("http")) {
  const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/**/*.{jpeg,jpg,png,gif,webp}",
  );

  const imagePath = image.startsWith("/") ? image : `/${image}`;

  if (!images[imagePath]) {
    throw new Error(`"${imagePath}" does not exist in glob pattern.`);
  }
  ``;
  optimizedImage = await getImage({ src: images[imagePath]() });
} else {
  optimizedImage.src = image;
}
---

<div
  class="w-full p-3 border border-neutral-300 dark:border-neutral-800 flex flex-col md:flex-row gap-4"
>
  <a
    class="block w-full md:w-36 h-48 md:h-36 aspect-square shrink-0 overflow-hidden bg-neutral-500"
    target={!id ? "_blank" : ""}
    href={!id ? link : `/blog/${id}`}
  >
    <img
      class="w-full h-full object-cover opacity-70"
      src={optimizedImage.src}
      alt={title}
    />
  </a>

  <div class="w-full flex flex-col justify-between min-w-0">
    <div class="flex flex-col gap-1">
      <h1 class="font-semibold text-lg leading-snug">
        <a
          class="hover:underline"
          target={!id ? "_blank" : ""}
          href={!id ? link : `/blog/${id}`}>{title}</a
        >
      </h1>
      <h3
        class="text-sm tracking-tight opacity-85 line-clamp-3 md:line-clamp-2"
      >
        {description}
      </h3>
    </div>

    <h4 class="text-xs text-right opacity-70 mt-2">
      {pubDate.toLocaleDateString()}
    </h4>
  </div>
</div>
