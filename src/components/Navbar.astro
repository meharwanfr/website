---
import ThemeToggle from "./ThemeToggle.astro";

const { nav_suffix } = Astro.props;
---

<main class="w-screen font-mono pt-7 flex items-center justify-center">
  <nav class="flex flex-col w-3/4 h-20 relative">
    <div class="path_div px-3 font-semibold flex items-center justify-between text-xl border w-full h-1/2">
      <h2>/ mehar {nav_suffix}</h2>
      <ThemeToggle />
    </div>
    <div class="border border-t-0 w-full h-1/2 flex items-center justify-center ">
      <div class="nav-links w-full flex justify-around font-semibold">
        <a href="/" class="inline-block dark:hover:bg-(--dark-selbg) hover:bg-(--light-selbg)">[ home ]</a>
        <a href="/about" class="inline-block dark:hover:bg-(--dark-selbg) hover:bg-(--light-selbg)">[ about ]</a>
        
        <a
          href="/projects"
          class="inline-block dark:hover:bg-(--dark-selbg) hover:bg-(--light-selbg)">[ projects ]</a
        >
        <a href="/blogs" class="inline-block dark:hover:bg-(--dark-selbg) hover:bg-(--light-selbg)">[ blogs ]</a>
        <a href="/now" class="inline-block dark:hover:bg-(--dark-selbg) hover:bg-(--light-selbg)">[ now ]</a>
        <a href="/gallery" class="inline-block dark:hover:bg-(--dark-selbg) hover:bg-(--light-selbg)">[ gallery ]</a>
      </div>
    </div>

  </nav>
</main>
