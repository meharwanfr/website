---
import ThemeToggle from "./ThemeToggle.astro";

const { nav_suffix = "" } = Astro.props;
---

<header
  class="w-full pt-3 md:pt-7 flex items-center justify-center font-ibm-mono"
>
  <div class="site-container flex flex-col relative">
    <div
      class="path_div p-2 gap-3 dark:text-(--dark-fg-2) font-semibold flex items-center justify-between md:text-xl lg:text-2xl border-2 border-neutral-800 w-full"
    >
      <p class="min-w-0 leading-snug">/ mehar {nav_suffix}</p>
      <ThemeToggle />
    </div>
    <nav
      class="w-full border-2 border-neutral-800 border-t-0"
      aria-label="Main navigation"
    >
      <div
        class="mx-auto grid w-full
      grid-cols-1 min-[320px]:grid-cols-2 sm:grid-cols-3
      xl:flex
      xl:items-center xl:justify-between
      gap-px lg:gap-1
      p-1.5 sm:p-2"
      >
        <a
          href="/"
          aria-current={Astro.url.pathname.replace(/\/$/, "") === "" ? "page" : undefined}
          aria-keyshortcuts="h"
          class="group flex items-center justify-center whitespace-nowrap
        px-2 py-2.5 sm:px-3 sm:py-3
        text-base sm:text-lg lg:text-xl
        font-semibold
        no-underline
        transition-colors duration-150
        hover:bg-(--light-selbg)
        dark:hover:bg-(--dark-selbg)
        dark:text-(--dark-fg-2)"
        >
          <span>[h]</span>
          <span class="ml-1.5">home</span>
        </a>

        <a
          href="/about"
          aria-current={Astro.url.pathname.replace(/\/$/, "") === "/about" ? "page" : undefined}
          aria-keyshortcuts="a"
          class="group flex items-center justify-center whitespace-nowrap
        px-2 py-2.5 sm:px-3 sm:py-3
        text-base sm:text-lg lg:text-xl
        font-semibold
        no-underline
        transition-colors duration-150
        hover:bg-(--light-selbg)
        dark:hover:bg-(--dark-selbg)
        dark:text-(--dark-fg-2)"
        >
          <span>[a]</span>
          <span class="ml-1.5">about</span>
        </a>

        <a
          href="/projects"
          aria-current={Astro.url.pathname.replace(/\/$/, "") === "/projects" ? "page" : undefined}
          aria-keyshortcuts="p"
          class="group flex items-center justify-center whitespace-nowrap
        px-2 py-2.5 sm:px-3 sm:py-3
        text-base sm:text-lg lg:text-xl
        font-semibold
        no-underline
        transition-colors duration-150
        hover:bg-(--light-selbg)
        dark:hover:bg-(--dark-selbg)
        dark:text-(--dark-fg-2)"
        >
          <span>[p]</span>
          <span class="ml-1.5">projects</span>
        </a>

        <a
          href="/blogs"
          aria-current={(Astro.url.pathname.replace(/\/$/, "") === "/blogs" || Astro.url.pathname.startsWith("/blog/")) ? "page" : undefined}
          aria-keyshortcuts="b"
          class="group flex items-center justify-center whitespace-nowrap
        px-2 py-2.5 sm:px-3 sm:py-3
        text-base sm:text-lg lg:text-xl
        font-semibold
        no-underline
        transition-colors duration-150
        hover:bg-(--light-selbg)
        dark:hover:bg-(--dark-selbg)
        dark:text-(--dark-fg-2)"
        >
          <span>[b]</span>
          <span class="ml-1.5">blogs</span>
        </a>

        <a
          href="/now"
          aria-current={Astro.url.pathname.replace(/\/$/, "") === "/now" ? "page" : undefined}
          aria-keyshortcuts="n"
          class="group flex items-center justify-center whitespace-nowrap
        px-2 py-2.5 sm:px-3 sm:py-3
        text-base sm:text-lg lg:text-xl
        font-semibold
        no-underline
        transition-colors duration-150
        hover:bg-(--light-selbg)
        dark:hover:bg-(--dark-selbg)
        dark:text-(--dark-fg-2)"
        >
          <span>[n]</span>
          <span class="ml-1.5">now</span>
        </a>

        <a
          href="/gallery"
          aria-current={Astro.url.pathname.replace(/\/$/, "") === "/gallery" ? "page" : undefined}
          aria-keyshortcuts="g"
          class="group flex items-center justify-center whitespace-nowrap
        px-2 py-2.5 sm:px-3 sm:py-3
        text-base sm:text-lg lg:text-xl
        font-semibold
        no-underline
        transition-colors duration-150
        hover:bg-(--light-selbg)
        dark:hover:bg-(--dark-selbg)
        dark:text-(--dark-fg-2)"
        >
          <span>[g]</span>
          <span class="ml-1.5">gallery</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Single-letter shortcuts apply only while the navigation has focus.
  // This leaves screen-reader shortcuts and ordinary typing available elsewhere.
  const routes: Record<string, string> = {
    h: "/", a: "/about", p: "/projects", b: "/blogs", n: "/now", g: "/gallery",
  };
  document.querySelector('nav[aria-label="Main navigation"]')?.addEventListener("keydown", (event) => {
    const e = event as KeyboardEvent;
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || e.repeat || e.defaultPrevented) return;
    const destination = routes[e.key];
    if (destination) {
      e.preventDefault();
      window.location.href = destination;
    }
  });
</script>
